<?xml version="1.0" encoding="UTF-8"?>
<inkscape-extension xmlns="http://www.inkscape.org/namespace/inkscape/extension">
  <name>Set up page for UV marker</name>
  <id>rkutter.setup.uv-marker</id>
  <param name="laser" type="string" gui-hidden="true">UV marker</param>
  <effect needs-live-preview="false">
    <object-type>all</object-type>
    <effects-menu>
      <submenu name="RKutter"/>
    </effects-menu>
  </effect>
  <script>
    <command location="inx" interpreter="python">laser_setup.py</command>
  </script>
</inkscape-extension>
